{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aludel",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-08-01",
  // plain-text vars are set in the dashboard (GOOGLE_MAPS_BROWSER_KEY, ALLOWED_EMAIL_DOMAINS…);
  // without this every deploy would delete them
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aludel",
      "database_id": "d67a9e14-6c21-42eb-95c8-938f40e63563"
    }
  ],
  // SQLite-backed Durable Objects: each user's chats, and each team's vault of filed reports
  "durable_objects": {
    "bindings": [
      { "name": "CHATS", "class_name": "ChatStore" },
      { "name": "VAULT", "class_name": "Vault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatStore"] },
    { "tag": "v2", "new_sqlite_classes": ["Vault"] }
  ],
  "observability": { "enabled": true }
}
